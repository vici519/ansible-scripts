---
- name: Удаление софта
  hosts: all
  gather_facts: no        # <--- ВОТ ЭТА СТРОКА ОТКЛЮЧАЕТ ПОИСК PYTHON!
  become: yes             # Выполнять от имени root
  
  tasks:
    - name: Добавляю vault
      ansible.builtin.raw: sed -i 's/mirror.centos.org/vault.centos.org/g' /etc/yum.repos.d/CentOS*.repo
      changed_when: true
  tasks:
    - name: Добавляю baseurl
      ansible.builtin.raw: sed -i 's/^#.*baseurl=http/baseurl=http/g' /etc/yum.repos.d/CentOS*.repo
      changed_when: true
  tasks:
    - name: Добавляю mirrorlist
      ansible.builtin.raw: sed -i 's/^mirrorlist=http/#mirrorlist=http/g' /etc/yum.repos.d/CentOS*.repo
      changed_when: true
  tasks:
    - name: Чищу кэщ
      ansible.builtin.raw: yum clean all
      changed_when: true
  tasks:
    - name: обновляю yum
      ansible.builtin.raw: yum update
      changed_when: true

